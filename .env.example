# Copier en .env et renseigner (JAMAIS committer .env)
DB_NAME=finance
DB_USER=finance
DB_PASSWORD=change-me-strong-password
APP_USER=admin
APP_PASSWORD=change-me-strong-password
# Cle AES 32 octets base64 pour chiffrer les tokens bancaires au repos (gen: openssl rand -base64 32)
APP_ENCRYPTION_KEY=change-me-openssl-rand-base64-32
TAG=latest
DUCKDNS_DOMAIN=mon-dashboard
DUCKDNS_TOKEN=change-me

# Connecteur PSD2 Crédit Mutuel Arkéa (voir docs/PSD2.md) - secrets jamais committés
BANK_PSD2_BASE_URL=https://<sandbox-ou-prod>.getarkea.com/stet/psd2/v1.6.2
BANK_PSD2_CLIENT_ID=change-me
BANK_PSD2_CLIENT_SECRET=change-me
BANK_PSD2_REDIRECT_URI=https://mon-dashboard.duckdns.org/bank-callback
